version(2);
project_name = "my_project";

patterns = {
    "*.c",
    "*.h",
    "*.bat",
    "*.4coder",
};

blacklist_patterns = {
    ".*",
};

load_paths = {
    .win = {
        { .path = ".", .recursive = true, .relative = true, },
    },
};

commands = {
    .build = {
        .win = "build.bat",
        .out = "*compilation*",
        .footer_panel = true,
        .save_dirty_files = true,
        .cursor_at_end = false,
    },
    .run = {
        .win = "build\\game.exe",
        .out = "*run*",
        .footer_panel = true,
        .save_dirty_files = true,
        .cursor_at_end = false,
    },
    .debug = {
        .win = "raddbg.exe build\\game.exe",
        .out = "*debug*",
        .footer_panel = true,
        .save_dirty_files = true,
        .cursor_at_end = false,
    },
};

fkey_command = {
    .F1 = "build",
    .F2 = "run",
    .F3 = "debug",
};